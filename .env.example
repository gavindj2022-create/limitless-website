# Copy to .env.local for local development. Set the same names in Vercel
# (Project > Settings > Environment Variables) for Preview and Production.
# Never commit real values.

# --- Lead email (required for the booking form and Bella hand-off) ---
RESEND_API_KEY=
# Must be an address on a domain verified in Resend, e.g. Limitless <hello@golimitlessagi.com>.
# The resend.dev fallback only delivers to the Resend account owner.
EMAIL_FROM=
# Where new-lead alerts go. Defaults to limitlessgav@gmail.com.
LEAD_NOTIFY_EMAIL=
# "on" emails the visitor a confirmation. Leave off until bot protection is in place.
LEAD_AUTOREPLY=

# --- Optional Google Sheet log (Apps Script web app ending in /exec) ---
LEADS_SHEET_URL=
LEADS_SHEET_SECRET=

# --- Optional AI mini-audit for Bella. Leave unset to keep Bella at $0 ---
# Do not set in production until rate limits use a shared store (see CODEX_BACKEND_REVIEW.md).
ANTHROPIC_API_KEY=
BELLA_MODEL=
# Max estimated USD per day per server instance for Bella AI calls.
BELLA_DAILY_MAX=

# --- Optional analytics (only load after a visitor accepts the cookie banner) ---
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
