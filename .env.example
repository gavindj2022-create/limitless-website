# ── Database ──────────────────────────────────────────────────────
DATABASE_URL=                           # PostgreSQL connection string

# ── NextAuth ──────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000      # Canonical URL of the site
NEXTAUTH_SECRET=                        # openssl rand -base64 32

# ── Google OAuth ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=                       # Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_SECRET=

# ── Stripe ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=                      # sk_test_... or sk_live_...
STRIPE_WEBHOOK_SECRET=                  # whsec_... (from Stripe Dashboard → Webhooks)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=     # pk_test_... or pk_live_...

# Stripe Price IDs (create products in Stripe Dashboard first)
STRIPE_PRICE_STARTER=                   # price_... for $29/mo Starter
STRIPE_PRICE_GROWTH=                    # price_... for $199/mo Growth
STRIPE_PRICE_FULL_OPS=                  # price_... for $499/mo Full Ops

# ── Resend (email) ────────────────────────────────────────────────
RESEND_API_KEY=                         # re_... from resend.com/api-keys
EMAIL_FROM=onboarding@resend.dev        # Optional. Defaults to onboarding@resend.dev.
                                        # Set to a verified-domain address for production
                                        # (e.g. hello@yourdomain.com) so emails deliver to anyone.
LEAD_NOTIFY_EMAIL=gavindj2022@gmail.com # Where lead/booking notification emails are sent.
                                        # Defaults to gavindj2022@gmail.com.

# ── App ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
